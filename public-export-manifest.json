{
  "schema_version": 1,
  "manifest_kind": "public-export",
  "status": "candidate-opinionated-workflow",
  "release_line": "v0.1.0-leyu-opinionated-workflow",
  "public_repository": "st-character-card-authoring-public",
  "history_policy": {
    "mode": "fresh_history",
    "source_history_exported": false,
    "source_branches_exported": false,
    "source_tags_exported": false,
    "rationale": "The private production repository contains internal paths, project names, and historical material."
  },
  "authoritative_documents": [
    "PUBLIC_RELEASE_ARCHITECTURE.md",
    "skill-manifest.json",
    "public-export-manifest.json",
    "workflow-provenance-manifest.json"
  ],
  "review_manifest": "release/public-review-manifest.json",
  "provenance_manifest": "workflow-provenance-manifest.json",
  "require_provenance": true,
  "manual_review_policy": {
    "unresolved_action": "fail",
    "bulk_include_flag": "forbidden",
    "approval_statuses": [
      "approved_public",
      "third_party_reviewed",
      "rejected_private"
    ]
  },
  "source_scope": {
    "include": [
      "README.md",
      "SKILL.md",
      "PUBLIC_RELEASE.md",
      "PUBLIC_RELEASE_ARCHITECTURE.md",
      "SOURCES.md",
      "SECURITY.md",
      "LICENSE",
      "CHANGELOG.md",
      ".gitignore",
      ".gitattributes",
      "skill-manifest.json",
      "public-export-manifest.json",
      "release/public-review-manifest.json",
      "workflow-provenance-manifest.json",
      "scripts/**",
      "references/**",
      "templates/**",
      "tests/**",
      ".github/workflows/**"
    ],
    "exclude": [
      ".git/**",
      "**/.git/**",
      ".pytest_cache/**",
      "**/__pycache__/**",
      "**/*.pyc",
      "**/*.pyo",
      "**/*.bak",
      "**/*.tmp",
      "**/_archived/**",
      "**/_maintenance_backups/**",
      "build/**",
      "reports/**",
      "release/public-core/**",
      "dist/**",
      "*.env",
      ".env*",
      "**/*credential*",
      "private-card-exports/**",
      "source-text-and-media/**",
      "private-credentials/**"
    ],
    "manual_review": []
  },
  "redaction_rules": [
    {
      "id": "private-path",
      "action": "fail",
      "patterns": [
        "C:\\Users\\<name>",
        "D:\\hermes",
        "/home/<name>/",
        "/mnt/c/Users/<name>/"
      ]
    },
    {
      "id": "secret-material",
      "action": "fail",
      "patterns": [
        "PRIVATE_KEY_BLOCK_MARKER",
        "github-classic-token-prefix",
        "github-fine-grained-token-prefix",
        "sk-<long-token>",
        "API_KEY=<value>",
        "TOKEN=<value>"
      ]
    },
    {
      "id": "private-project-identity",
      "action": "manual_review",
      "patterns": [
        "private card filename",
        "private novel filename",
        "personal username",
        "machine-specific project path"
      ]
    },
    {
      "id": "third-party-source",
      "action": "manual_review",
      "patterns": [
        "copied dialogue",
        "novel excerpt",
        "existing IP",
        "unlicensed tutorial",
        "referenced preset"
      ]
    }
  ],
  "contract_sources": {
    "skill_capability_manifest": "skill-manifest.json",
    "export_and_redaction_manifest": "public-export-manifest.json",
    "architecture_document": "PUBLIC_RELEASE_ARCHITECTURE.md",
    "workflow_provenance_manifest": "workflow-provenance-manifest.json"
  },
  "dependency_policy": {
    "authoritative_source": "skill-manifest.json",
    "frontmatter_dependencies_must_not_contradict": true,
    "version_policy": "pin_or_bound_every_required_sibling_before_v1",
    "installer_may_auto_modify_environment": false
  },
  "trust_boundary": {
    "builder_execution_default": "static_only",
    "explicit_execution_flag": "--execute-builder",
    "trust_source": [
      "explicit_cli",
      "trusted_ci_workspace",
      "user_global_policy"
    ],
    "manifest_may_declare_trust": false,
    "child_environment": "allowlist_only",
    "required_controls": [
      "timeout",
      "stdin_devnull",
      "working_directory_isolation",
      "output_limit"
    ],
    "sandbox_claim": "temporary_directory_is_not_a_security_sandbox"
  },
  "evidence_levels": [
    "SPECIFIED",
    "STATIC_VERIFIED",
    "INTEGRATION_VERIFIED",
    "RUNTIME_VERIFIED",
    "OBSERVED",
    "CONFORMANCE_VERIFIED"
  ],
  "required_release_gates": [
    "audit_public_release",
    "audit_docs_links",
    "full_pytest",
    "pipeline_static_audit",
    "compileall",
    "workflow_provenance_resolved",
    "private_path_and_secret_scan",
    "export_tree_rebuild_check",
    "exact_head_github_actions",
    "nested_public_core_reference_integrity"
  ],
  "planned_artifacts": [
    "README.md",
    "SKILL.md",
    "PUBLIC_RELEASE.md",
    "PUBLIC_RELEASE_ARCHITECTURE.md",
    "SOURCES.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md",
    "skill-manifest.json",
    "public-export-manifest.json",
    "release/public-review-manifest.json",
    "scripts/**",
    "references/**",
    "templates/**",
    "tests/**",
    ".github/workflows/**"
  ],
  "current_blockers": [],
  "overrides": {},
  "capability_contract": {
    "authoritative_manifest": "skill-manifest.json",
    "level_definitions": "skill-manifest.json"
  },
  "product_kind": "opinionated_personal_workflow",
  "workflow_profile": "leyu-workflow",
  "artifact_profile": "workflow-distribution",
  "artifact_release_line": "v0.1.0-public-readiness-core-rc2",
  "strict_core_artifact": "release/public-core/",
  "known_boundaries": [
    "This is Leyu's opinionated personal workflow, not an official or universal SillyTavern standard.",
    "The nested release/public-core/ artifact is separately versioned and governed by its own strict Core export and provenance contracts.",
    "Native stage routing, preset integration, and SillyTavern runtime remain optional or host-dependent capabilities.",
    "Remote GitHub Actions is evidence for the pushed commit; local and remote test counts are reported separately."
  ],
  "known_limitations": [
    "Static and integration checks do not prove SillyTavern import behavior, model quality, UI rendering, or runtime behavior.",
    "Optional sibling skills and runtime hosts are not bundled by the workflow distribution."
  ],
  "strict_core_manifest": "release/public-core/public-export-manifest.json",
  "strict_core_provenance_manifest": "release/public-core/provenance-manifest.json"
}
