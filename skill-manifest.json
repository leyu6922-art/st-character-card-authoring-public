{
  "schema_version": 1,
  "manifest_kind": "skill-capability",
  "status": "candidate",
  "skill_name": "st-character-card-authoring",
  "release_version": "0.1.0-leyu-opinionated-workflow",
  "compatibility": {
    "python": ">=3.11",
    "card_formats": [
      "CCv3"
    ],
    "hermes": "required_for_agent_workflow",
    "sillytavern_runtime": "not_claimed_without_runtime_evidence"
  },
  "capabilities": {
    "core_validation": {
      "level": "L1",
      "status": "available",
      "requires": [],
      "checks": [
        "manifest",
        "documentation",
        "public_artifact",
        "doctor",
        "tests"
      ]
    },
    "release_export": {
      "level": "L1",
      "status": "available",
      "requires": [],
      "checks": [
        "allowlist",
        "overrides",
        "provenance",
        "review",
        "trace"
      ]
    },
    "authoring_workflow": {
      "level": "L2",
      "status": "available",
      "workflow_kind": "opinionated_personal_workflow",
      "profile": "leyu-workflow",
      "bundled": true,
      "bundled_paths": [
        "SKILL.md",
        "scripts/**",
        "references/**",
        "templates/**",
        "tests/**"
      ],
      "requires": [
        "hermes-agent"
      ],
      "evidence_level": "STATIC_VERIFIED",
      "missing_behavior": "HOST_REQUIRED"
    },
    "native_stage_routing": {
      "level": "L3",
      "status": "optional_dependency",
      "requires": [
        "standalone-card-stage-routing"
      ],
      "missing_behavior": "MISSING"
    },
    "runtime_stack": {
      "level": "L4",
      "status": "not_configured",
      "requires": [
        "sillytavern",
        "tavern-helper"
      ],
      "missing_behavior": "NOT_CONFIGURED"
    }
  },
  "dependencies": [
    {
      "name": "hermes-agent",
      "kind": "host",
      "required_for": [
        "authoring_workflow"
      ],
      "version_policy": "document_compatibility_before_v1"
    },
    {
      "name": "standalone-card-stage-routing",
      "kind": "sibling-skill",
      "required_for": [
        "native_stage_routing",
        "runtime_stack"
      ],
      "version_policy": "pin_or_bounded_range_before_v1"
    },
    {
      "name": "sillytavern-preset-debugging",
      "kind": "sibling-skill",
      "required_for": [
        "runtime_stack"
      ],
      "version_policy": "pin_or_bounded_range_before_v1"
    },
    {
      "name": "sillytavern",
      "kind": "runtime",
      "required_for": [
        "runtime_stack"
      ],
      "version_policy": "runtime_matrix_required"
    },
    {
      "name": "tavern-helper",
      "kind": "runtime-extension",
      "required_for": [
        "runtime_stack"
      ],
      "version_policy": "runtime_matrix_required"
    }
  ],
  "profiles": {
    "ccv3-core": {
      "kind": "portable_schema_and_type_boundary",
      "status": "existing"
    },
    "st-authoring-recommended": {
      "kind": "public_neutral_profile",
      "status": "planned"
    },
    "strict-production": {
      "kind": "portable_strict_quality_profile",
      "status": "planned"
    },
    "leyu-production": {
      "kind": "validation_profile",
      "status": "existing",
      "scope": "validator and delivery quality profile used by validate_card.py and production gates",
      "compatibility_note": "This is a validation profile, not an alias for the leyu-workflow distribution profile."
    },
    "leyu-workflow": {
      "kind": "opinionated_personal_workflow",
      "status": "existing",
      "default_for": [
        "authoring_workflow"
      ],
      "scope": "bundled workflow profile for Leyu personal authoring process"
    }
  },
  "evidence_levels": [
    "SPECIFIED",
    "STATIC_VERIFIED",
    "INTEGRATION_VERIFIED",
    "RUNTIME_VERIFIED",
    "OBSERVED",
    "CONFORMANCE_VERIFIED"
  ],
  "single_source_policy": {
    "capabilities_and_dependencies": "this_file",
    "public_export_scope_and_redaction": "public-export-manifest.json",
    "human_explanation": "PUBLIC_RELEASE_ARCHITECTURE.md",
    "derived_documents_must_be_checked": true,
    "capability_level_definitions": "this_file",
    "workflow_provenance": "workflow-provenance-manifest.json"
  },
  "capability_level": "L2",
  "capability_level_definitions": {
    "L1": "Portable CCv3/Worldbook validation and release-integrity infrastructure",
    "L2": "Bundled Leyu opinionated SillyTavern authoring workflow; Hermes Agent is required for Agent execution",
    "L3": "Native stage routing via optional sibling capability",
    "L4": "Full runtime stack via configured host and optional integrations"
  },
  "distribution": {
    "kind": "opinionated_personal_workflow",
    "profile": "leyu-workflow",
    "strict_core_artifact": "release/public-core/",
    "strict_core_version": "0.1.0-public-readiness-core-rc2"
  }
}
